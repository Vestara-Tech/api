{
  "version": 2,
  "defaultLevel": "affected",
  "levels": {
    "V0": "static",
    "V1": "affected",
    "V2": "module",
    "V3": "platform"
  },
  "fullVerificationTriggers": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "tsconfig.json",
    "tsconfig.build.json",
    "vitest.config.ts",
    ".vestara/verification.json"
  ],
  "neverWatch": true,
  "reuseEvidence": true,
  "escalateOnUnknownImpact": true,
  "contractPatterns": [
    "contracts/**",
    "src/routes/**",
    "**/*.schema.ts",
    "**/*.types.ts",
    "**/contracts/**"
  ],
  "sharedModules": [
    "core",
    "bootstrap",
    "plugins",
    "types"
  ],
  "modules": {
    "agent": {
      "sources": ["src/agent/**"],
      "tests": ["tests/unit/agent*.test.ts", "tests/integration/ai-agent-api.test.ts"]
    },
    "ai": {
      "sources": ["src/ai/**"],
      "tests": [
        "tests/unit/ai*.test.ts",
        "tests/integration/ai-agent-api.test.ts",
        "tests/integration/ai-execute-api.test.ts",
        "tests/integration/ai-v2-api.test.ts",
        "tests/integration/ai-v2-evaluation-api.test.ts",
        "tests/integration/ai-v2-runtime-api.test.ts"
      ]
    },
    "auth": {
      "sources": ["src/auth/**"],
      "tests": ["tests/unit/auth*.test.ts", "tests/integration/auth-api.test.ts"],
      "dependsOn": ["core", "user", "database", "configuration"]
    },
    "browser": {
      "sources": ["src/browser/**"],
      "tests": ["tests/unit/browser-module.test.ts", "tests/integration/browser-api.test.ts"]
    },
    "builder": {
      "sources": ["src/builder/**", "src/builder-plane/**", "src/appbuilder/**"],
      "tests": [
        "tests/unit/builder*.test.ts",
        "tests/integration/builder-api.test.ts",
        "tests/integration/builder-platform-api.test.ts",
        "tests/integration/builder-wiring.test.ts",
        "tests/integration/builder-plane-v2-api.test.ts"
      ]
    },
    "capabilities": {
      "sources": ["src/capabilities/**"],
      "tests": ["tests/unit/capabilities.test.ts"]
    },
    "car": {
      "sources": ["src/car/**"],
      "tests": ["tests/unit/car-module.test.ts"]
    },
    "component": {
      "sources": ["src/component/**"],
      "tests": ["tests/unit/component-module.test.ts", "tests/integration/component-api.test.ts"]
    },
    "configuration": {
      "sources": ["src/config/**", "src/configuration/**"],
      "tests": ["tests/unit/config*.test.ts", "tests/integration/config-api.test.ts", "tests/integration/config-expanded-api.test.ts"]
    },
    "context": {
      "sources": ["src/context/**"],
      "tests": ["tests/unit/context-module.test.ts", "tests/integration/context-api.test.ts"]
    },
    "dashboard": {
      "sources": ["src/dashboard/**"],
      "tests": ["tests/unit/dashboard*.test.ts", "tests/integration/dashboard-api.test.ts"]
    },
    "database": {
      "sources": ["src/database/**"],
      "tests": ["tests/unit/database-module.test.ts", "tests/integration/database-api.test.ts"],
      "dependsOn": ["core"]
    },
    "diagnostics": {
      "sources": ["src/diagnostics/**"],
      "tests": ["tests/unit/diagnostics-module.test.ts", "tests/integration/diagnostics-api.test.ts"]
    },
    "file": {
      "sources": ["src/file/**"],
      "tests": ["tests/unit/file-module.test.ts", "tests/integration/file-api.test.ts"]
    },
    "generation-plane": {
      "sources": ["src/generation-plane/**"],
      "tests": ["tests/unit/generation-plane.test.ts"]
    },
    "generator": {
      "sources": ["src/generator/**"],
      "tests": ["tests/unit/generator*.test.ts", "tests/integration/generator-api.test.ts"]
    },
    "image": {
      "sources": ["src/image/**"],
      "tests": [
        "tests/unit/image*.test.ts",
        "tests/integration/image-builder-api.test.ts",
        "tests/integration/image-execution-api.test.ts",
        "tests/integration/image-platform-v2-api.test.ts"
      ]
    },
    "log": {
      "sources": ["src/log/**"],
      "tests": ["tests/unit/log-module.test.ts", "tests/integration/log-api.test.ts"]
    },
    "login": {
      "sources": ["src/login/**"],
      "tests": ["tests/unit/login-core.test.ts", "tests/integration/login-api.test.ts"]
    },
    "marketplace": {
      "sources": ["src/marketplace/**"],
      "tests": [
        "tests/unit/marketplace*.test.ts",
        "tests/integration/marketplace-api.test.ts",
        "tests/integration/marketplace-v2-api.test.ts"
      ]
    },
    "milestone": {
      "sources": ["src/milestone/**"],
      "tests": ["tests/unit/milestone-module.test.ts", "tests/integration/milestone-api.test.ts"]
    },
    "onboarding": {
      "sources": ["src/onboarding/**"],
      "tests": ["tests/unit/onboarding*.test.ts", "tests/integration/onboarding-api.test.ts"],
      "dependsOn": ["core", "capabilities", "configuration", "generator", "auth", "bootstrap", "ai"]
    },
    "os": {
      "sources": ["src/os/**"],
      "tests": ["tests/unit/os-module.test.ts", "tests/integration/os-api.test.ts"]
    },
    "permission": {
      "sources": ["src/permission/**"],
      "tests": ["tests/unit/permission-module.test.ts", "tests/integration/permission-api.test.ts"],
      "dependsOn": ["core", "user"]
    },
    "startup": {
      "sources": ["src/startup/**"],
      "tests": ["tests/unit/startup*.test.ts", "tests/integration/startup-api.test.ts"],
      "dependsOn": ["configuration", "core", "bootstrap"]
    },
    "system": {
      "sources": ["src/system/**"],
      "tests": [
        "tests/unit/system*.test.ts",
        "tests/integration/system-api.test.ts",
        "tests/integration/system-v2-api.test.ts",
        "tests/integration/system-daemon-api.test.ts",
        "tests/integration/connectivity-contract.test.ts"
      ]
    },
    "task": {
      "sources": ["src/task/**"],
      "tests": ["tests/unit/task-module.test.ts", "tests/integration/task-api.test.ts"]
    },
    "template": {
      "sources": ["src/template/**"],
      "tests": ["tests/unit/template-module.test.ts", "tests/integration/template-api.test.ts"]
    },
    "worker": {
      "sources": ["src/worker/**"],
      "tests": ["tests/unit/worker-store.test.ts", "tests/unit/worker-loop.test.ts", "tests/unit/worker-event-bridge.test.ts", "tests/unit/worker-scheduler.test.ts"],
      "dependsOn": ["core"]
    },
    "test": {
      "sources": ["src/test/**"],
      "tests": ["tests/unit/test-expanded.test.ts", "tests/integration/test-api.test.ts"]
    },
    "theme": {
      "sources": ["src/theme/**"],
      "tests": ["tests/unit/theme-module.test.ts", "tests/integration/theme-api.test.ts"]
    },
    "vestara-ui": {
      "sources": ["packages/vestara-ui/src/**"],
      "tests": ["packages/vestara-ui/tests/**/*.test.tsx"],
      "dependsOn": ["theme"],
      "cwd": "packages/vestara-ui"
    },
    "admin-ui": {
      "sources": ["vestara-apps/admin/src/**"],
      "tests": ["vestara-apps/admin/tests/**/*.test.ts"],
      "dependsOn": ["vestara-ui"],
      "cwd": "vestara-apps/admin"
    },
    "workspace-ui": {
      "sources": ["vestara-apps/workspace/src/**"],
      "tests": ["vestara-apps/workspace/tests/**/*.test.ts"],
      "dependsOn": ["vestara-ui"],
      "cwd": "vestara-apps/workspace"
    },
    "user": {
      "sources": ["src/user/**"],
      "tests": ["tests/unit/user-module.test.ts", "tests/integration/user-api.test.ts"],
      "dependsOn": ["core", "database"]
    },
    "workflow": {
      "sources": ["src/workflow/**"],
      "tests": ["tests/unit/workflow-runtime.test.ts", "tests/integration/workflow-api.test.ts"]
    },
    "routes": {
      "sources": ["src/routes/**"],
      "tests": ["tests/integration/**/*.test.ts"],
      "dependsOn": ["bootstrap"]
    },
    "contracts": {
      "sources": ["contracts/**"],
      "tests": ["tests/contract/**/*.test.ts", "tests/integration/**/*.test.ts"]
    },
    "app": {
      "sources": ["src/app.ts", "src/main.ts"],
      "tests": ["tests/integration/server.test.ts", "tests/integration/startup-api.test.ts"]
    }
  }
}
