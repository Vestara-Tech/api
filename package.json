{
  "name": "@vestara/api",
  "version": "2.0.0-alpha.1",
  "description": "Vestara API v2 — Platform Gateway and Control Plane (standalone)",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "contracts:frontend": "tsx scripts/generate-frontend-contracts.ts",
    "contracts:frontend:check": "tsx scripts/check-frontend-contracts.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@scalar/fastify-api-reference": "^1.65.1",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
