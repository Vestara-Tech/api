# ── OpenCode Runtime Configuration (DEX-CP0) ─────────────────
#
# Controls how Vestara connects to the OpenCode coding agent runtime.
# See src/car/domain/opencode-config.ts for the typed schema.

# Mode: "external" (connect to running server) or "managed" (start server)
OPENCODE_MODE=external

# External server URL (required when mode=external)
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Managed server settings (ignored when mode=external)
# OPENCODE_HOSTNAME=127.0.0.1
# OPENCODE_PORT=4096

# Default AI provider/model (optional — resolved via models.dev when unset)
# OPENCODE_DEFAULT_PROVIDER=
# OPENCODE_DEFAULT_MODEL=

# Startup timeout for managed mode (ms)
# OPENCODE_STARTUP_TIMEOUT_MS=30000
